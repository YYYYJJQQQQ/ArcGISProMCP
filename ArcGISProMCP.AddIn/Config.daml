<?xml version="1.0" encoding="utf-8" ?>
<ArcGIS defaultAssembly="ArcGISProMCP.AddIn.dll"
        defaultNamespace="ArcGISProMCP.AddIn"
        xmlns="http://schemas.esri.com/DADF/Registry"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://schemas.esri.com/DADF/Registry ArcGIS.Desktop.Framework.xsd">

  <AddInInfo id="{a95d0781-3951-442b-a3d4-2e31003b1753}" version="1.9.0" desktopVersion="3.7.1901" product="ArcGISPro">
    <Name>ArcGISProMCP.AddIn</Name>   
    <Description>ArcGIS Pro MCP：工程、图层、空间分析、地图布局与自动化制图</Description>
    <Image>Images\AddinDesktop32.png</Image>
    <Author>YYYYJJQQQQ and contributors</Author>
    <Company>Community project</Company>
    <Date>2026/10/17 1:31:31</Date>
    <Subject>Framework</Subject>
    <!-- Note subject can be one or more of these topics:
                    Content, Framework, Editing, Geodatabase, Geometry, Geoprocessing, Layouts, Map Authoring, Map Exploration -->
  </AddInInfo>

  <modules>
    <insertModule id="ArcGISProMCP_AddIn_Module" className="Module1" autoLoad="false" caption="ArcGIS Pro MCP">
      <!-- uncomment to have the control hosted on a separate tab-->
      <tabs>
        <!--<tab id="ArcGISProMCP.AddIn_Tab1" caption="New Tab">
          <group refID="ArcGISProMCP.AddIn_Group1"/>
        </tab>-->
      </tabs>
              
      <groups>
        <!-- comment this out if you have no controls on the Addin tab to avoid
              an empty group-->
        <group id="ArcGISProMCP_AddIn_Group1" caption="ArcGIS Pro MCP" appearsOnAddInTab="true" keytip="M1">
          <button refID="ArcGISProMCP_StartConnection" size="large" />
          <button refID="ArcGISProMCP_StopConnection" size="large" />
          <button refID="ArcGISProMCP_ConnectionStatus" size="large" />
          <button refID="ArcGISProMCP_WorkspaceSettings" size="large" />
        </group>
      </groups>
      
      <controls>
        <button id="ArcGISProMCP_StartConnection" caption="启动连接"
                className="Controls.StartConnectionButton" loadOnClick="true" keytip="MS"
                smallImage="Images\AddInDesktop16.png" largeImage="Images\AddInDesktop32.png">
          <tooltip heading="启动连接">启动本机连接服务。当前提供连通和状态检测。<disabledText /></tooltip>
        </button>
        <button id="ArcGISProMCP_StopConnection" caption="停止连接"
                className="Controls.StopConnectionButton" loadOnClick="true" keytip="MT"
                smallImage="Images\AddInDesktop16.png" largeImage="Images\AddInDesktop32.png">
          <tooltip heading="停止连接">停止服务并释放本机连接。<disabledText /></tooltip>
        </button>
        <button id="ArcGISProMCP_ConnectionStatus" caption="连接状态"
                className="Controls.ConnectionStatusButton" loadOnClick="true" keytip="MC"
                smallImage="Images\AddInDesktop16.png" largeImage="Images\AddInDesktop32.png">
          <tooltip heading="连接状态">查看服务状态、进程及连接名称。<disabledText /></tooltip>
        </button>
        <button id="ArcGISProMCP_WorkspaceSettings" caption="目录授权"
                className="Controls.WorkspaceSettingsButton" loadOnClick="true" keytip="MW"
                smallImage="Images\AddInDesktop16.png" largeImage="Images\AddInDesktop32.png">
          <tooltip heading="目录授权">直接选择工作目录、设置读取/新建/工程修改权限，保存后供后续调用使用。<disabledText /></tooltip>
        </button>
      </controls> 
      
    </insertModule>
  </modules>
</ArcGIS>
